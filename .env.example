# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=nivuba
DB_PASSWORD=secret
DB_NAME=nivuba_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ML service
ML_SERVICE_URL=http://nivuba-ml:7860
MAXMIND_LICENSE_KEY=

# App
PORT=3000
NODE_ENV=production
SEED_ADMIN_EMAIL=admin@nivuba.com
SEED_ADMIN_PASSWORD=Admin@123456!

# Credit decision policy (nivuba-core)
DECISION_MIN_SCORE=700
DECISION_MAX_PAYMENT_TO_INCOME=0.35
ML_TIMEOUT_MS=10000

# Host port for Postgres (change if 5432 is taken locally)
POSTGRES_HOST_PORT=5432
